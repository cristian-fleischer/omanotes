# Maintainer: Cristian Fleischer <cristian.fleischer@gmail.com>
# Fork of omawrite by David Heinemeier Hansson <david@hey.com>

pkgname=omanotes
pkgver=0.2.2
pkgrel=1
pkgdesc='Markdown notes app with a vault sidebar, forked from OmaWrite'
arch=('x86_64')
url='https://github.com/cristian-fleischer/omanotes'
license=('MIT' 'OFL-1.1')
install='omanotes.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
# No conflicts with omawrite: different binary, desktop file, icon and settings
# path, so both can be installed side by side.
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omanotes "$pkgdir/usr/bin/omanotes"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omanotes.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanotes.svg"
  /usr/bin/install -Dm644 "$startdir/omanotes.desktop" "$pkgdir/usr/share/applications/omanotes.desktop"
}
